rules_version = '2';

// P2 Field Control — Cloud Storage rules.
//
// Client document uploads land under jobs/{jobDocId}/client-uploads/ and
// CompanyCam photos are referenced by URL (not stored here). Require auth for
// all access and cap upload size; tighten per-path once query scoping lands
// (see SECURITY.md).

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
