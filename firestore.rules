rules_version = '2';

// P2 Field Control — Firestore security rules.
//
// Baseline posture: nothing is accessible without authentication, and the
// crown jewels (OAuth access tokens, app settings, user role records) are
// locked to staff (owner / internal) only.
//
// KNOWN LIMITATION: operational collections (jobs, extras, ...) are readable by
// any signed-in user. The builder/client portals currently scope what each
// user SEES in JavaScript (DataContext: tenantId / clientJobIds), not at the
// database layer, because the portals issue unscoped collection queries.
// Per-tenant and per-client read isolation at the database layer is being
// enforced in a later task of this plan, once those queries are scoped. Until
// then these rules close the highest-value holes (auth required everywhere;
// tokens, settings and roles protected) without breaking the existing
// client-side filtering.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Role comes from a custom claim when present, otherwise the users doc.
    // The 'in' test matters: reading a missing claim directly throws and
    // denies the request, which locked out every user without a claim.
    function userRole() {
      return ('role' in request.auth.token)
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            : null);
    }

    function isOwner() {
      return signedIn() && userRole() == 'owner';
    }

    function isStaff() {
      return signedIn() && (userRole() == 'owner' || userRole() == 'internal');
    }

    // ── Secrets: QuickBooks / CompanyCam OAuth tokens. Staff only. ──────────
    // (Cloud Functions use the Admin SDK and bypass these rules.)
    match /qb_config/{doc=**} { allow read, write: if isStaff(); }
    match /cc_config/{doc=**} { allow read, write: if isStaff(); }

    // ── App settings + agent config: everyone reads, staff writes. ──────────
    match /config/{doc=**}       { allow read: if signedIn(); allow write: if isStaff(); }
    match /agent_alerts/{doc}    { allow read: if signedIn(); allow write: if isStaff(); }

    // ── User records hold roles + client scoping — never self-writable, ─────
    //    so a user can't escalate their own role or widen clientJobIds.
    match /users/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid || isStaff());
      // Owners write any record. Internal staff may only write builder or
      // client records, so they cannot mint owners or other staff.
      allow write: if isOwner()
        || (isStaff() && request.resource.data.role in ['builder', 'client']);
      // Builders accept Terms of Access as themselves.
      match /termsAcceptances/{version} {
        allow read, write: if signedIn() && (request.auth.uid == uid || isStaff());
      }
    }

    // ── Device push tokens. A user registers their own; staff can read all. ─
    match /fcm_tokens/{token} {
      allow read:  if isStaff();
      allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // ── Client error log: any signed-in user may report an error as ────────
    //    themselves. Only staff read. No updates or deletes.
    match /error_logs/{doc} {
      allow create: if signedIn()
        && request.resource.data.userEmail == request.auth.token.email;
      allow read: if isStaff();
    }

    // ── Crew scores and app settings: everyone reads, staff writes. ─────────
    match /crew_scores/{doc}  { allow read: if signedIn(); allow write: if isStaff(); }
    match /app_settings/{doc} { allow read: if signedIn(); allow write: if isStaff(); }

    // ── Operational data: signed-in access (see KNOWN LIMITATION above). ────
    match /jobs/{doc=**}            { allow read, write: if signedIn(); }
    match /extras/{doc=**}          { allow read, write: if signedIn(); }
    match /notifications/{doc}      { allow read, write: if signedIn(); }
    match /subs/{doc}               { allow read, write: if signedIn(); }
    match /materials/{doc}          { allow read, write: if signedIn(); }
    match /permits/{doc}            { allow read, write: if signedIn(); }
    match /submits/{doc=**}         { allow read, write: if signedIn(); }
    match /daily_reports/{doc}      { allow read, write: if signedIn(); }
    match /urgent_items/{doc}       { allow read, write: if signedIn(); }
    match /history/{doc}            { allow read, write: if signedIn(); }
    match /supplier_invoices/{doc}  { allow read, write: if signedIn(); }

    // Default deny: any path not matched above is inaccessible.
  }
}
